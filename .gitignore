!.env.example
.qdrant-key

# runtime state — committed schemas only, not actual content
queue/pending/*.md
queue/in_progress/*.md
queue/complete/*.md
queue/blocked/*.md
queue/archive/**
sessions/*.yaml
sessions/*.checkpoint.yaml
events/**
pending_ingest/**
logs/**
backups/**
data/qdrant/**
data/pr_babysitter_state.json
registry/sources.yaml

# misc local detritus (not part of the orchestrator)
research/
state/
# The spaces plan's per-feature state files are tracked (SP-080).
!docs/spaces/state/
tmp_audit/
# Literal `~` directory created by a tilde-not-expanded shell command
/~

# editor / OS
.DS_Store
.idea/
.vscode/

